# ============================================================
# NCBCNet 环境变量模板
#
# 【开发环境 · 零配置】直接运行即可，无需本文件、无需 MySQL/Redis：
#     python manage.py runserver 0.0.0.0:8000
#     cd frontend && npm run dev
#   默认：SQLite + 进程内缓存(LocMemCache) + 开发密钥 + localhost 白名单。
#
# 【生产环境 · 必须配置】复制为 .env 后填写，缺失关键项会启动失败：
#     cp .env.example .env
#   DJANGO_SECRET_KEY / ALLOWED_HOSTS 缺失或为不安全默认值时，Django 会拒绝启动。
# ============================================================

# ---------- 基础（生产必填） ----------
APP_ENV=production
DEBUG=false
# 生产务必生成随机密钥：python -c "import secrets;print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-random-secret

# ---------- 主机与来源（生产必填） ----------
# 真实域名，逗号分隔；不允许 *
ALLOWED_HOSTS=ncnetstudent.top,www.ncnetstudent.top
CSRF_TRUSTED_ORIGINS=https://ncnetstudent.top,https://www.ncnetstudent.top

# ---------- 数据库（生产必填；开发默认 SQLite，无需配置） ----------
# sqlite / postgresql
DB_ENGINE=postgresql
DB_HOST=db
DB_PORT=5432
DB_NAME=ncnetdb
DB_USER=ncnet
# PostgreSQL 官方镜像以 DB_USER 为超级用户、DB_PASSWORD 为其口令；不再需要 DB_ROOT_PASSWORD。
DB_PASSWORD=change-me-db-password

# ---------- Redis（生产默认 redis://redis:6379/1，可覆盖；开发默认进程内缓存，无需配置） ----------
# REDIS_URL=redis://redis:6379/1

# ---------- HTTPS / 安全 ----------
# 生产开启：Nginx 终止 TLS 后，强制安全 Cookie 与 HSTS
ENABLE_HTTPS_REDIRECT=true
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=Lax
# DRF Browsable API：仅当「DEBUG=true 且此处为 true」时启用（生产无论如何不启用）
# ENABLE_BROWSABLE_API=true

# ---------- 文件 / 对象存储（阶段三，可选） ----------
# 未配置 OSS_ENDPOINT_URL 时使用本地磁盘存储
# OSS_ENDPOINT_URL=https://oss-cn-xxx.aliyuncs.com
# OSS_ACCESS_KEY_ID=
# OSS_SECRET_ACCESS_KEY=
# OSS_BUCKET=ncbcnet-media
# OSS_QUERYSTRING_AUTH=true

# 签名下载链接有效期（秒）
DOWNLOAD_LINK_TTL=300

# ---------- 前端（可选） ----------
# 生产构建使用相对 /api/v1；如需指向其它后端可覆盖
# VITE_API_BASE_URL=/api/v1
